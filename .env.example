# GenDevibe Provider Registry — .env minta
# Másold .env néven, és töltsd ki amit használni akarsz.
# Bármelyik hiányozhat — a registry csak azokat a providereket regisztrálja,
# amikhez van kulcs (Ollama és Jan.ai mindig regisztrálva van, lokális).

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
COPILOT_API_KEY=

# Lokális végpontok (csak ha nem a default címen futnak)
OLLAMA_BASE_URL=http://127.0.0.1:11434
JAN_BASE_URL=http://127.0.0.1:1337/v1

# Figma personal access token (node import/export-hoz)
FIGMA_TOKEN=

# Nyelv: hu | en
GENDEVIBE_LOCALE=hu
